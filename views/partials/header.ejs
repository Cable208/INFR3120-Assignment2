
<!--
    INFR3120 - Assignment 2
    Shared Header for Portfolio Website

    This header is included on every EJS page.
    It contains the page setup, stylesheets,
    and Bootstrap navigation bar.
-->

<!DOCTYPE html>
<html lang="en">

<head>
    <!-- Allows the browser to display text correctly -->
    <meta charset="UTF-8">

    <!-- Makes the website responsive on phones and tablets -->
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <!-- Uses EJS to display the title for each page -->
    <title><%= title %> | My Portfolio</title>

    <!-- Bootstrap provides responsive layouts and components -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
          rel="stylesheet">

    <!-- Font Awesome provides icons used throughout the website -->
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css"
          rel="stylesheet">

    <!-- Reused CSS from Assignment 1 for different screen sizes -->
    <link rel="stylesheet"
          href="/stylesheets/computer.css"
          media="only screen and (min-width: 960px)">

    <link rel="stylesheet"
          href="/stylesheets/tablet.css"
          media="only screen and (min-width: 481px) and (max-width: 959px)">

    <link rel="stylesheet"
          href="/stylesheets/mobile.css"
          media="only screen and (max-width: 480px)">

    <!-- Additional custom styling for the portfolio -->
    <link rel="stylesheet" href="/stylesheets/style.css">
</head>

<body>

    <!-- Shared navigation bar used across all four portfolio pages -->
    <nav class="navbar navbar-expand-lg navbar-dark bg-dark">

        <!-- Bootstrap container keeps navigation aligned -->
        <div class="container">

            <!-- Website title links back to the Home page -->
            <a class="navbar-brand" href="/">My Portfolio</a>

            <!-- Button displays the menu on smaller screens -->
            <button class="navbar-toggler" type="button"
                    data-bs-toggle="collapse"
                    data-bs-target="#navbarNav"
                    aria-controls="navbarNav"
                    aria-expanded="false"
                    aria-label="Toggle navigation">

                <span class="navbar-toggler-icon"></span>
            </button>

            <!-- Collapsible navigation links -->
            <div class="collapse navbar-collapse" id="navbarNav">

                <ul class="navbar-nav ms-auto">

                    <!-- Home page link -->
                    <li class="nav-item">
                        <a class="nav-link" href="/">Home</a>
                    </li>

                    <!-- About Me page link -->
                    <li class="nav-item">
                        <a class="nav-link" href="/about">About Me</a>
                    </li>

                    <!-- Projects page link -->
                    <li class="nav-item">
                        <a class="nav-link" href="/projects">Projects</a>
                    </li>

                    <!-- Contact page link -->
                    <li class="nav-item">
                        <a class="nav-link" href="/contact">Contact</a>
                    </li>

                </ul>
            </div>
        </div>
    </nav>
