
<%- include('partials/header', { title: 'Contact Me' }) %>

<main class="container my-5">

    <section id="contact" class="mx-auto" style="max-width: 650px;">

        <h1 class="text-center mb-4">Contact Me</h1>

        <p class="text-center mb-4">
            If you would like to get in touch with me,
            please fill out the form below.
        </p>

        <form id="contactForm">

            <!-- Name -->
            <div class="mb-3">
                <label for="name" class="form-label">Name:</label>
                <input type="text"
                       class="form-control"
                       id="name"
                       name="name"
                       required>
            </div>

            <!-- Email -->
            <div class="mb-3">
                <label for="email" class="form-label">Email:</label>
                <input type="email"
                       class="form-control"
                       id="email"
                       name="email"
                       required>
            </div>

            <!-- Phone -->
            <div class="mb-3">
                <label for="phone" class="form-label">Cell Number:</label>
                <input type="tel"
                       class="form-control"
                       id="phone"
                       name="phone"
                       pattern="[0-9]{10}"
                       placeholder="9051234567"
                       required>
            </div>

            <!-- Message -->
            <div class="mb-3">
                <label for="comments" class="form-label">Comments:</label>
                <textarea class="form-control"
                          id="comments"
                          name="comments"
                          rows="6"
                          required></textarea>
            </div>

            <button type="submit" class="btn btn-primary">
                <i class="fa-solid fa-paper-plane"></i>
                Submit
            </button>

        </form>

        <p id="formMessage" class="mt-3" role="status"></p>

    </section>

</main>

<script>
    document.getElementById('contactForm')
        .addEventListener('submit', function(event) {
            event.preventDefault();

            document.getElementById('formMessage').textContent =
                'Form validation passed! This is a demonstration form.';
        });
</script>

<%- include('partials/footer') %>
