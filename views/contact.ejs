
<!--
    INFR3120 - Assignment 2
    Contact Me Page

    This page provides a contact form where visitors
    can enter their name, email, cell number, and comments.

    Bootstrap is used for the form layout and styling.
    HTML validation makes sure required fields are completed.
    JavaScript displays a confirmation message after validation.

    The form is for demonstration purposes and does not
    actually send emails.
-->

<!-- Includes the shared header and navigation bar -->
<%- include('partials/header', { title: 'Contact Me' }) %>

<!-- Bootstrap container centers the page content -->
<main class="container my-5">

    <!-- Contact section with a maximum width for readability -->
    <section id="contact" class="mx-auto" style="max-width: 650px;">

        <!-- Main heading -->
        <h1 class="text-center mb-4">Contact Me</h1>

        <!-- Instructions for visitors -->
        <p class="text-center mb-4">
            If you would like to get in touch with me,
            please fill out the form below.
        </p>

        <!-- Contact form using Bootstrap styling -->
        <form id="contactForm">

            <!-- Name field requires the visitor to enter their name -->
            <div class="mb-3">
                <label for="name" class="form-label">Name:</label>
                <input type="text"
                       class="form-control"
                       id="name"
                       name="name"
                       required>
            </div>

            <!-- Email field uses the email type for basic validation -->
            <div class="mb-3">
                <label for="email" class="form-label">Email:</label>
                <input type="email"
                       class="form-control"
                       id="email"
                       name="email"
                       required>
            </div>

            <!-- Phone field requires a 10-digit cell number -->
            <div class="mb-3">
                <label for="phone" class="form-label">Cell Number:</label>
                <input type="tel"
                       class="form-control"
                       id="phone"
                       name="phone"
                       pattern="[0-9]{10}"
                       placeholder="9051234567"
                       required>
            </div>

            <!-- Textarea allows visitors to write a longer message -->
            <div class="mb-3">
                <label for="comments" class="form-label">Comments:</label>
                <textarea class="form-control"
                          id="comments"
                          name="comments"
                          rows="6"
                          required></textarea>
            </div>

            <!-- Submit button includes a Font Awesome icon -->
            <button type="submit" class="btn btn-primary">
                <i class="fa-solid fa-paper-plane"></i>
                Submit
            </button>

        </form>

        <!-- Displays feedback after successful form validation -->
        <p id="formMessage" class="mt-3" role="status"></p>

    </section>

</main>

<!-- JavaScript handles the demonstration form submission -->
<script>
    // Finds the form using its ID and listens for submission
    document.getElementById('contactForm')
        .addEventListener('submit', function(event) {

            // Prevents the form from submitting and reloading the page
            event.preventDefault();

            // Displays a message once HTML form validation passes
            // No email is sent because this is a demonstration form
            document.getElementById('formMessage').textContent =
                'Form validation passed! This is a demonstration form.';
        });
</script>

<!-- Includes the shared footer and closes the HTML document -->
<%- include('partials/footer') %>
